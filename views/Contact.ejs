    justify-content: space-evenly; /* Distribuye los elementos de forma equitativa */
    align-items: center; /* Centra los items verticalmente */
    background: #23364B;
    width: 100%;
}

.exo-menu > li {
    display: inline-block; /* Asegura que cada li sea un bloque en línea */
}

.exo-menu > li > a {
    color: #ccc;
    text-decoration: none;
    text-transform: uppercase;
    padding: 20px 22px;
    display: inline-block;
    transition: color 0.2s linear, background 0.2s linear;
    border-radius: 48px;
}

.exo-menu > li > a.active,
.exo-menu > li > a:hover {
    background: #009FE1;
    color: #fff;
}

@media (max-width: 767px) {
    .exo-menu {
        flex-direction: column; /* En pantallas pequeñas, cambia la orientación a vertical */
        min-height: 58px;
        width: 100%;
    }
    
    .exo-menu > li {
        width: 100%;
    }

    .exo-menu > li > a {
        display: block;
        padding: 20px 22px;
    }}
